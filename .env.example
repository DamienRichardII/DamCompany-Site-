# ---------------------------------------------------------------------------
# Site public — domaine de production : https://damcompany.tech
# (metadataBase, canonical, Open Graph, sitemap.xml, JSON-LD)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://damcompany.tech

# Réseaux sociaux (header, footer, contact) — remplacer par les vrais profils
# NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@...
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/...

# Contact affiché sur le site (défaut : contact@damcompany.tech)
# NEXT_PUBLIC_CONTACT_EMAIL=contact@damcompany.tech

# --- Formulaire de contact (/api/contact) — Resend, domaine damcompany.tech vérifié ---
# Sans RESEND_API_KEY, l'API répond 503 et le formulaire propose l'email en secours.
# RESEND_API_KEY=
# CONTACT_TO=contact@damcompany.tech
# CONTACT_FROM=DamCompany <site@damcompany.tech>

# --- Mentions légales (page /mentions-legales) ---
# Tant qu'ils ne sont pas renseignés, la page affiche « En cours de renseignement ».
# NEXT_PUBLIC_LEGAL_NAME=
# NEXT_PUBLIC_LEGAL_FORM=
# NEXT_PUBLIC_LEGAL_SIRET=
# NEXT_PUBLIC_LEGAL_VAT=

# --- Espace admin (/admin) — Supabase Auth, accès restreint par liste d'emails ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ADMIN_EMAILS=contact@damcompany.tech,autre@exemple.com

# ===========================================================================
# Carte de fidélité (/carte-de-fidelite) — AUCUN secret ici, uniquement les noms.
# Chaque bloc active UNE fonctionnalité réelle ; sans lui, l'interface affiche
# « bientôt disponible » et l'API répond 503 (rien n'est simulé).
# Voir docs/carte-de-fidelite/MISE-EN-SERVICE.md
# ===========================================================================

# 1) Demande d'activation par e-mail (Resend). RESEND_API_KEY peut être partagée.
# RESEND_API_KEY=
# LOYALTY_ACTIVATION_TO=contact@damcompany.com
# LOYALTY_ACTIVATION_FROM=cartes@damcompany.com

# 2) Paiement + base de données (les 6 sont nécessaires)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=            # signature du webhook /api/stripe/webhook
# STRIPE_LOYALTY_PRICE_ID=          # créé dans Stripe : le prix n'est jamais saisi dans le code
# STRIPE_LOYALTY_MODE=subscription  # ou "payment" pour un paiement unique
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # SERVEUR UNIQUEMENT, jamais préfixée NEXT_PUBLIC_

# 3) Apple Wallet (certificats encodés en base64, SERVEUR UNIQUEMENT)
# APPLE_PASS_TYPE_ID=pass.com.exemple.fidelite
# APPLE_TEAM_ID=
# APPLE_WWDR_CERT_B64=
# APPLE_SIGNER_CERT_B64=
# APPLE_SIGNER_KEY_B64=
# APPLE_SIGNER_KEY_PASSPHRASE=

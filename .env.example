# URL publique de production (utilisée pour metadataBase, canonical, OG,
# sitemap.xml — doc 16-D.1/E). Sans cette variable, le site utilise
# http://localhost:3000 par défaut (dev uniquement, ne pas laisser en prod).
NEXT_PUBLIC_SITE_URL=https://damcompany.com

